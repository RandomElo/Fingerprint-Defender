{
  "manifest_version": 3,
  "name": "Fingerprint Shield",
  "version": "3.0.0",
  "description": "Brouille les empreintes de navigateur, coupe les fuites vers les sites, masque les nuisances et vérifie la fiabilité des sites avant d'ouvrir un lien.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fingerprint-shield@eloi.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"], "optional": ["browsingActivity"] }
    }
  },
  "icons": { "16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage", "scripting", "tabs", "webRequest", "webRequestBlocking", "alarms"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "style.css", "shared.js", "defaults.js", "icons/icon.svg"], "matches": ["<all_urls>"] }
  ],
  "background": { "scripts": ["defaults.js", "reputation.js", "background.js"] },
  "action": {
    "default_title": "Fingerprint Shield",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
